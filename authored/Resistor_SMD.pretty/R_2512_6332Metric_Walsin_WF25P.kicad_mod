(module R_2512_6332Metric_Walsin_WF25P (layer F.Cu) (tedit 6745A000)
  (descr "Resistor SMD 2512 (6332 Metric), Walsin WF25P 2 W thick film, Walsin's recommended solder pads W 3.7 x D 2.45 mm, L 7.6 mm overall (ASC_WFxxP_V03 MAR-2017, Recommended Solder Pad Dimensions); the 2 W rating needs 300 mm2 of pad + trace copper (its note 3). Body from KiCad R_2512_6332Metric. Staged 2026-11-29 for the speaker board's Zobel R_z")
  (tags "resistor 2512 Walsin WF25P")
  (attr smd)
  (fp_text reference REF** (at 0 -2.9) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value R_2512_6332Metric_Walsin_WF25P (at 0 2.9) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_line (start -3.15 1.6) (end -3.15 -1.6) (layer F.Fab) (width 0.1))
  (fp_line (start -3.15 -1.6) (end 3.15 -1.6) (layer F.Fab) (width 0.1))
  (fp_line (start 3.15 -1.6) (end 3.15 1.6) (layer F.Fab) (width 0.1))
  (fp_line (start 3.15 1.6) (end -3.15 1.6) (layer F.Fab) (width 0.1))
  (fp_line (start -1.2 -2.0) (end 1.2 -2.0) (layer F.SilkS) (width 0.12))
  (fp_line (start -1.2 2.0) (end 1.2 2.0) (layer F.SilkS) (width 0.12))
  (fp_line (start -4.05 2.1) (end -4.05 -2.1) (layer F.CrtYd) (width 0.05))
  (fp_line (start -4.05 -2.1) (end 4.05 -2.1) (layer F.CrtYd) (width 0.05))
  (fp_line (start 4.05 -2.1) (end 4.05 2.1) (layer F.CrtYd) (width 0.05))
  (fp_line (start 4.05 2.1) (end -4.05 2.1) (layer F.CrtYd) (width 0.05))
  (pad 1 smd roundrect (at -2.575 0) (size 2.45 3.7) (layers F.Cu F.Mask F.Paste) (roundrect_rratio 0.1))
  (pad 2 smd roundrect (at 2.575 0) (size 2.45 3.7) (layers F.Cu F.Mask F.Paste) (roundrect_rratio 0.1))
  (fp_text user %R (at 0 0) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (model ${KISYS3DMOD}/Resistor_SMD.3dshapes/R_2512_6332Metric.wrl
    (at (xyz 0 0 0))
    (scale (xyz 1 1 1))
    (rotate (xyz 0 0 0))
  )
)
