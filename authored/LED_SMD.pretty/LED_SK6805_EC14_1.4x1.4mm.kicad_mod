(module LED_SK6805_EC14_1.4x1.4mm (layer F.Cu) (tedit 68D4A100)
  (descr "OPSCO SK6805-EC14 addressable RGB LED, 1.4 x 1.4 x 0.4 mm, 4-pad SMD. AUTHORED 2026-09-25 from the manufacturer drawing: Guangdong OPSCO SK6805-EC14-000 rev A/1, mirrored at press/references/components/sk6805-ec14-datasheet.pdf, retrieved 2026-09-22 from the LCSC datasheet link on jlcpcb.com/partdetail/C2909055. PADS are section 6, 'PCB recommended pad size': 0.50 x 0.50 mm on a 0.40 mm gap, so centres sit at +/-0.45 on both axes. That is the SAME pad geometry as the SK6805-EC15 this part replaces, which is why the copper did not move - see press/references/components/sk6805-ec14-vs-ec15.md. BODY is section 4: 1.4 x 1.4 mm, so F.Fab is +/-0.7 and the courtyard +/-0.95, both 0.05 tighter than the EC15's. PIN NUMBERING IS THE MANUFACTURER'S, and it is NOT the EC15's: on this part 1 = VDD, 2 = DOUT, 3 = GND, 4 = DIN, where the EC15 reads 1 = DIN, 2 = VDD, 3 = DOUT, 4 = GND. Both run 1-2-3-4 counterclockwise so pad N is the same physical corner on both parts, and ONLY the function-to-number mapping differs - which is why substituting the part without remapping press's ADDRESSABLE_LED_*_PAD constants drives data into VDD. Those constants are the other half of this footprint and live in rust/press-layout/src/construct/constants.rs. ORIGIN is on the functional datum, the emitting-area centre: the die is centred in the package and every feature here is symmetric about (0,0). PIN 1 IS MARKED THREE TIMES AND ALL THREE AGREE, unlike the EC15 footprint this replaces, whose chamfer and glyph pointed at different corners. On F.Fab: the body-outline chamfer, and the '1' glyph. On F.SilkS: an L bracket outside pad 1, in 0.15 mm line because that is JLCPCB's minimum silkscreen line width (references/components/datasheets/jlcpcb_pcb_capabilities.txt) - the predecessor drew its bracket at 0.10 mm, under spec. Its centreline stands 0.95 mm off the origin, so the nearest copper-to-silk gap is 0.175 mm against JLC's 0.15 mm minimum. THE SILK BRACKET IS THE ONLY PIN-1 MARK THAT REACHES A GERBER, and JLCPCB's placement preview draws the part from their own library over our silkscreen, which makes it the one cross-check a human gets on rotation before paying. TEXT is still never put on F.SilkS: a legal 0.8 mm glyph (press board rule min_text_height) is larger than the 1.4 mm part it would label, and the EC15 footprint raised 66 DRC warnings that way, so the '1' lives on the assembly layer.")
  (tags "LED RGB addressable SK6805 EC14 1414")
  (attr smd)
  (fp_text reference REF** (at 0 -1.7) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value LED_SK6805_EC14_1.4x1.4mm (at 0 1.7) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text user %R (at 0.025 0) (layer F.Fab)
    (effects (font (size 0.3 0.3) (thickness 0.05)))
  )
  (fp_line (start -0.95 0.95) (end -0.95 -0.95) (layer F.CrtYd) (width 0.05))
  (fp_line (start 0.95 0.95) (end -0.95 0.95) (layer F.CrtYd) (width 0.05))
  (fp_line (start 0.95 -0.95) (end 0.95 0.95) (layer F.CrtYd) (width 0.05))
  (fp_line (start -0.95 -0.95) (end 0.95 -0.95) (layer F.CrtYd) (width 0.05))
  (fp_line (start -0.7 0.7) (end 0.7 0.7) (layer F.Fab) (width 0.1))
  (fp_line (start 0.7 0.7) (end 0.7 -0.7) (layer F.Fab) (width 0.1))
  (fp_line (start 0.7 -0.7) (end -0.325 -0.7) (layer F.Fab) (width 0.1))
  (fp_line (start -0.325 -0.7) (end -0.7 -0.325) (layer F.Fab) (width 0.1))
  (fp_line (start -0.7 -0.325) (end -0.7 0.7) (layer F.Fab) (width 0.1))
  (fp_line (start -0.95 -0.35) (end -0.95 -0.95) (layer F.SilkS) (width 0.15))
  (fp_line (start -0.95 -0.95) (end -0.35 -0.95) (layer F.SilkS) (width 0.15))
  (fp_text user 1 (at -0.925 -0.45) (layer F.Fab)
    (effects (font (size 0.3 0.3) (thickness 0.075)))
  )
  (pad 1 smd rect (at -0.45 -0.45) (size 0.5 0.5) (layers F.Cu F.Paste F.Mask))
  (pad 2 smd rect (at -0.45 0.45) (size 0.5 0.5) (layers F.Cu F.Paste F.Mask))
  (pad 3 smd rect (at 0.45 0.45) (size 0.5 0.5) (layers F.Cu F.Paste F.Mask))
  (pad 4 smd rect (at 0.45 -0.45) (size 0.5 0.5) (layers F.Cu F.Paste F.Mask))
)
