(module SW_MX_HanElectricity_CPG151101D01_THT (layer F.Cu) (tedit 68EB0000)
  (descr "HanElectricity (Hanyones) MX-style THT key switch, 3-pin: 2 plated contacts plus centre NPTH post, NO side pegs. ONE footprint for LCSC C49234238 (CPG151101D01 linear) and C49234235 (CPG151101D13 clicky): both sample approval sheets carry the same outline drawing and PCB layout. AUTHORED 2026-10-12 from studio/press/references/components/key-switches/han-C49234238-CPG151101D01.pdf (drawing sheet 'new' 2015/5/3 rev A, PDF page 8; 'Recommended PCB Layout', 'Keyswitch without Fixation Pins' 1-Pole, PDF page 6 = printed page 5 of 6) and han-C49234235-CPG151101D13.pdf (same drawing, PDF page 8). ORIGIN is the SWITCH CENTRE = centre post axis. Top view, +x right, +y down (KiCad). SOURCED: centre NPTH dia 3.90 +0.10/-0 at 0,0; two contact holes dia 1.50 +/-0.05 at (-3.81,-2.54) and (2.54,-5.08) (drawing 3.80 / 2.54 / 2.54 / 5.08, tolerance X.x +/-0.20; 3.81 used to stay on the 1.27 grid); body 13.95 (x) by 15.60 (y) housing outline from the top view. LED WINDOW (PCB layout, 1-Pole w/LED legend 'MAX 3.5 x 2.8'): blue square drawn on F.Fab at centre (0,+4.7), 3.5 wide x 2.8 tall, on the side opposite the contacts; centre y scaled by eye from the layout grid (about +/-0.3), orientation of 3.5 vs 2.8 assumed from the symbol; it is a keep-in reference only, no cutout. UNSOURCED: annular pad diameter 2.5, courtyard margin, pad numbering 1/2 (drawing labels the terminals 8 and 11 and shows only a 2-terminal circuit), outline silkscreen omitted. Plate cutout 14.00 +/-0.05 R0.30 max per the same sheet is NOT drawn here.")
  (tags "key switch MX HanElectricity CPG151101D01 CPG151101D13 C49234238 C49234235 THT")
  (fp_text reference REF** (at 0 -8.9) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value SW_MX_HanElectricity_CPG151101D01_THT (at 0 8.9) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text user %R (at 0 0) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_line (start -6.98 -7.8) (end 6.98 -7.8) (layer F.Fab) (width 0.12))
  (fp_line (start 6.98 -7.8) (end 6.98 7.8) (layer F.Fab) (width 0.12))
  (fp_line (start 6.98 7.8) (end -6.98 7.8) (layer F.Fab) (width 0.12))
  (fp_line (start -6.98 7.8) (end -6.98 -7.8) (layer F.Fab) (width 0.12))
  (fp_line (start -1.75 3.3) (end 1.75 3.3) (layer F.Fab) (width 0.12))
  (fp_line (start 1.75 3.3) (end 1.75 6.1) (layer F.Fab) (width 0.12))
  (fp_line (start 1.75 6.1) (end -1.75 6.1) (layer F.Fab) (width 0.12))
  (fp_line (start -1.75 6.1) (end -1.75 3.3) (layer F.Fab) (width 0.12))
  (fp_line (start -7.25 -8.05) (end 7.25 -8.05) (layer F.CrtYd) (width 0.05))
  (fp_line (start 7.25 -8.05) (end 7.25 8.05) (layer F.CrtYd) (width 0.05))
  (fp_line (start 7.25 8.05) (end -7.25 8.05) (layer F.CrtYd) (width 0.05))
  (fp_line (start -7.25 8.05) (end -7.25 -8.05) (layer F.CrtYd) (width 0.05))
  (pad 1 thru_hole circle (at -3.81 -2.54) (size 2.5 2.5) (drill 1.5) (layers *.Cu *.Mask))
  (pad 2 thru_hole circle (at 2.54 -5.08) (size 2.5 2.5) (drill 1.5) (layers *.Cu *.Mask))
  (pad "" np_thru_hole circle (at 0 0) (size 3.9 3.9) (drill 3.9) (layers *.Cu *.Mask))
)
