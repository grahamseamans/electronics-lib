(footprint "loom_port_xlarge" (version 20240108) (generator loom) (layer "F.Cu")
  (descr "loom PORT net tie, 2 mm via / 1.2 mm drill. Source: electronics/loom/docs/loom.md, the ports section — this is loom's own geometry, not a manufactured part, so its primary source is the spec that defines it. Two through-hole vias 1.85 mm apart, joined by a 2 mm wide copper BRIDGE on every outer copper layer. That spacing is the tightest at which each drill still clears the other terminal's copper by KiCad's 0.25 mm hole clearance (0.25 mm actual) — butting the vias until their rings overlapped instead is what KiCad 9 DRC rejects, and the two constraints cannot both hold with round vias. Pad 1 = INSIDE (module net, -y); pad 2 = OUTSIDE (loom net, +y); loom.md puts the port row on the module's bottom, and KiCad y is DOWN. Origin = the tie centre (the port anchor). Regenerate with electronics-lib/tools/generate_loom_port_net_ties.py.")
  (tags "loom port net tie via")
  (attr through_hole exclude_from_pos_files exclude_from_bom)
  (net_tie_pad_groups "1,2")
  (fp_text reference "REF**" (at 0 -2.675) (layer "F.SilkS")
    (effects (font (size 0.8 0.8) (thickness 0.12))))
  (fp_text value "loom_port_xlarge" (at 0 2.675) (layer "F.Fab")
    (effects (font (size 0.8 0.8) (thickness 0.12))))
  (fp_line (start -1.15 -2.075) (end 1.15 -2.075) (layer "F.CrtYd") (stroke (width 0.05) (type solid)))
  (fp_line (start 1.15 -2.075) (end 1.15 2.075) (layer "F.CrtYd") (stroke (width 0.05) (type solid)))
  (fp_line (start 1.15 2.075) (end -1.15 2.075) (layer "F.CrtYd") (stroke (width 0.05) (type solid)))
  (fp_line (start -1.15 2.075) (end -1.15 -2.075) (layer "F.CrtYd") (stroke (width 0.05) (type solid)))
  (fp_line (start -1 -1.925) (end 1 -1.925) (layer "F.Fab") (stroke (width 0.12) (type solid)))
  (fp_line (start 1 -1.925) (end 1 1.925) (layer "F.Fab") (stroke (width 0.12) (type solid)))
  (fp_line (start 1 1.925) (end -1 1.925) (layer "F.Fab") (stroke (width 0.12) (type solid)))
  (fp_line (start -1 1.925) (end -1 -1.925) (layer "F.Fab") (stroke (width 0.12) (type solid)))
  (fp_line (start 0 -0.925) (end 0 0.925) (layer "F.Cu") (stroke (width 2) (type solid)))
  (fp_line (start 0 -0.925) (end 0 0.925) (layer "B.Cu") (stroke (width 2) (type solid)))
  (pad "1" thru_hole circle (at 0 -0.925) (size 2 2) (drill 1.2) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 0 0.925) (size 2 2) (drill 1.2) (layers "*.Cu" "*.Mask"))
)
