(footprint "loom_port_large" (version 20240108) (generator loom) (layer "F.Cu")
  (descr "loom PORT net tie, 1.8 mm via / 1.1 mm drill. Source: electronics/loom/docs/loom.md, the ports section — this is loom's own geometry, not a manufactured part, so its primary source is the spec that defines it. Two through-hole vias 2.2 mm apart, joined by a 1.8 mm wide copper BRIDGE on every outer copper layer. That spacing lets a track as wide as the pad land on the inside terminal's centre 0.4 mm clear of the outside terminal (the module router lands at the centre), and leaves each drill 0.75 mm from the other terminal's copper (KiCad's hole clearance is 0.25 mm); butting the vias until their rings overlapped is what KiCad 9 DRC rejects. Pad 1 = INSIDE (module net, -y); pad 2 = OUTSIDE (loom net, +y); loom.md puts the port row on the module's bottom, and KiCad y is DOWN. Origin = the tie centre (the port anchor). Regenerate with electronics-lib/tools/generate_loom_port_net_ties.py.")
  (tags "loom port net tie via")
  (attr through_hole exclude_from_pos_files exclude_from_bom)
  (net_tie_pad_groups "1,2")
  (fp_text reference "REF**" (at 0 -2.75) (layer "F.SilkS")
    (effects (font (size 0.8 0.8) (thickness 0.12))))
  (fp_text value "loom_port_large" (at 0 2.75) (layer "F.Fab")
    (effects (font (size 0.8 0.8) (thickness 0.12))))
  (fp_line (start -1.05 -2.15) (end 1.05 -2.15) (layer "F.CrtYd") (stroke (width 0.05) (type solid)))
  (fp_line (start 1.05 -2.15) (end 1.05 2.15) (layer "F.CrtYd") (stroke (width 0.05) (type solid)))
  (fp_line (start 1.05 2.15) (end -1.05 2.15) (layer "F.CrtYd") (stroke (width 0.05) (type solid)))
  (fp_line (start -1.05 2.15) (end -1.05 -2.15) (layer "F.CrtYd") (stroke (width 0.05) (type solid)))
  (fp_line (start -0.9 -2) (end 0.9 -2) (layer "F.Fab") (stroke (width 0.12) (type solid)))
  (fp_line (start 0.9 -2) (end 0.9 2) (layer "F.Fab") (stroke (width 0.12) (type solid)))
  (fp_line (start 0.9 2) (end -0.9 2) (layer "F.Fab") (stroke (width 0.12) (type solid)))
  (fp_line (start -0.9 2) (end -0.9 -2) (layer "F.Fab") (stroke (width 0.12) (type solid)))
  (fp_line (start 0 -1.1) (end 0 1.1) (layer "F.Cu") (stroke (width 1.8) (type solid)))
  (fp_line (start 0 -1.1) (end 0 1.1) (layer "B.Cu") (stroke (width 1.8) (type solid)))
  (pad "1" thru_hole circle (at 0 -1.1) (size 1.8 1.8) (drill 1.1) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 0 1.1) (size 1.8 1.8) (drill 1.1) (layers "*.Cu" "*.Mask"))
)
