(module RotaryEncoder_Alps_EC12E_Vertical_20mmShaft (layer F.Cu) (tedit 68E9A000)
  (descr "Alps Alpine EC12E 12 mm incremental encoder, insulated flatted shaft, NO push switch, vertical PCB mount, 20 mm operating-part length (LM1 = 20, flat length l1 = 7). ONE footprint for EC12E2430404 (no detents, 24 pulses; LCSC C470602) and EC12E24204A8 (24 detents, 24 pulses): the catalogue lists both as drawing No. 1 (High collar type), so they share outline and PCB hole pattern. AUTHORED 2026-10-10 from ALPS ALPINE catalogue 'EC12E / EC12D 12型绝缘轴型', printed page 277 (PDF page 2 of C470602-alps-ec12e-catalog.pdf, mirrored at press/references/fab/lcsc-parts/; no revision stamp on the sheet), drawing No. 1 and its column 'PCB mounting hole dimensions, seen from the insertion side'. ORIGIN is ON THE SHAFT AXIS. SOURCED from that drawing: 3 pin holes drill 1.0 at 2.5 mm pitch, pin order A C B left to right, on a row 7.5 mm from the shaft axis (the leg holes sit on the shaft axis row, 7.5 mm from the pin row); 2 leg holes 2.0 x 2.1 mm, 13.2 mm apart outer edge to outer edge so centres at +/-5.6; body 12.4 wide, 13.2 deep (+/-6.2, +/-6.6), 14 over the legs; shaft 6 dia, 4.5 across flats over l1 = 7, 6.8 dia collar. UNSOURCED (this author's choice, not in the catalogue): annular pad diameters 1.8 mm on the pins, the 3.0 x 3.1 mm copper around each leg hole, the courtyard margin, silkscreen positions, the pin-row-to-body-edge split of the 7.5 mm (body edge drawn at the drawing's symmetric +/-6.6), the leg pad name MP and leg plating (the catalogue only gives hole sizes). Pin 1 does not exist on this part: pads are named A, C, B as on the drawing; A is the left pin seen from above with the pins toward +y (down). https://www.alpsalpine.com/e/products/detail/EC12E2430404/")
  (tags "rotary encoder alps alpsalpine EC12E EC12E2430404 EC12E24204A8 vertical no switch")
  (fp_text reference REF** (at 0 -8.1) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value RotaryEncoder_Alps_EC12E_Vertical_20mmShaft (at 0 10.4) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text user %R (at 0 0) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )

  (fp_line (start -6.2 -6.6) (end 6.2 -6.6) (layer F.Fab) (width 0.12))
  (fp_line (start 6.2 -6.6) (end 6.2 6.6) (layer F.Fab) (width 0.12))
  (fp_line (start 6.2 6.6) (end -6.2 6.6) (layer F.Fab) (width 0.12))
  (fp_line (start -6.2 6.6) (end -6.2 -6.6) (layer F.Fab) (width 0.12))
  (fp_circle (center 0 0) (end 3.4 0) (layer F.Fab) (width 0.12))
  (fp_circle (center 0 0) (end 3 0) (layer F.Fab) (width 0.12))

  (fp_line (start -6.3 -6.7) (end -3.5 -6.7) (layer F.SilkS) (width 0.12))
  (fp_line (start 3.5 -6.7) (end 6.3 -6.7) (layer F.SilkS) (width 0.12))
  (fp_line (start -6.3 -6.7) (end -6.3 -2.4) (layer F.SilkS) (width 0.12))
  (fp_line (start 6.3 -6.7) (end 6.3 -2.4) (layer F.SilkS) (width 0.12))
  (fp_line (start -6.3 2.4) (end -6.3 6.7) (layer F.SilkS) (width 0.12))
  (fp_line (start 6.3 2.4) (end 6.3 6.7) (layer F.SilkS) (width 0.12))
  (fp_line (start -6.3 6.7) (end -4.0 6.7) (layer F.SilkS) (width 0.12))
  (fp_line (start 4.0 6.7) (end 6.3 6.7) (layer F.SilkS) (width 0.12))

  (fp_line (start -7.5 -7.1) (end 7.5 -7.1) (layer F.CrtYd) (width 0.05))
  (fp_line (start 7.5 -7.1) (end 7.5 8.6) (layer F.CrtYd) (width 0.05))
  (fp_line (start 7.5 8.6) (end -7.5 8.6) (layer F.CrtYd) (width 0.05))
  (fp_line (start -7.5 8.6) (end -7.5 -7.1) (layer F.CrtYd) (width 0.05))

  (pad A thru_hole rect (at -2.5 7.5) (size 1.8 1.8) (drill 1) (layers *.Cu *.Mask))
  (pad C thru_hole circle (at 0 7.5) (size 1.8 1.8) (drill 1) (layers *.Cu *.Mask))
  (pad B thru_hole circle (at 2.5 7.5) (size 1.8 1.8) (drill 1) (layers *.Cu *.Mask))
  (pad MP_1 thru_hole rect (at -5.6 0) (size 3 3.1) (drill oval 2 2.1) (layers *.Cu *.Mask))
  (pad MP_2 thru_hole rect (at 5.6 0) (size 3 3.1) (drill oval 2 2.1) (layers *.Cu *.Mask))
)
