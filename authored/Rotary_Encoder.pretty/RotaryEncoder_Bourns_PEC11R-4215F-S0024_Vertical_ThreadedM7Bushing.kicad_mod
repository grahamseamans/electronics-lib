  (pad B thru_hole circle (at 2.5 7.5) (size 1.8 1.8) (drill 1) (layers *.Cu *.Mask))
  (pad SW1 thru_hole circle (at -2.5 -7) (size 1.8 1.8) (drill 1) (layers *.Cu *.Mask))
  (pad SW2 thru_hole circle (at 2.5 -7) (size 1.8 1.8) (drill 1) (layers *.Cu *.Mask))
  (pad MP_1 thru_hole rect (at -5.7 0) (size 2.9 3.7) (drill oval 1.9 2.7) (layers *.Cu *.Mask))
