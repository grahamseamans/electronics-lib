  (fp_line (start 6.25 2.4) (end 6.25 6.7) (layer F.SilkS) (width 0.12))
  (fp_line (start -4.4 8.7) (end -3.4 8.7) (layer F.SilkS) (width 0.12))
  (fp_line (start -3.9 8.2) (end -3.9 9.2) (layer F.SilkS) (width 0.12))

  (fp_line (start -7.4 -8.15) (end 7.4 -8.15) (layer F.CrtYd) (width 0.05))
  (fp_line (start 7.4 -8.15) (end 7.4 8.65) (layer F.CrtYd) (width 0.05))
  (fp_line (start 7.4 8.65) (end -7.4 8.65) (layer F.CrtYd) (width 0.05))
  (fp_line (start -7.4 8.65) (end -7.4 -8.15) (layer F.CrtYd) (width 0.05))

  (pad A thru_hole rect (at -2.5 7.5) (size 1.8 1.8) (drill 1) (layers *.Cu *.Mask))
