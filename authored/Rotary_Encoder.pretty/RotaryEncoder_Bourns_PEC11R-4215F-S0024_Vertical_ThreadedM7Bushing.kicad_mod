(module RotaryEncoder_Bourns_PEC11R-4215F-S0024_Vertical_ThreadedM7Bushing (layer F.Cu) (tedit 68A9F2C0)
  (descr "Bourns PEC11R-4215F-S0024, 12 mm incremental encoder, 24 detents, 24 pulses/rev, push momentary switch. VERTICAL mount, terminal option 4 (PC pin horizontal / rear facing) so the shaft stands perpendicular to the PCB. THREADED M7 x 0.75 panel bushing, 5.0 mm long, supplied with one flat washer (OD 12.0, ID 7.1, 0.5 thick) and one hex nut (A/F 10.0, 2.0 thick): this part CAN clamp a front panel. Case 12.5 x 13.4 mm, 6.5 mm from the PCB seating face to the bushing shoulder; shaft 15.0 mm above the shoulder, 6.0 mm dia, flatted to 4.5 mm over the last 7.0 mm. Origin is ON THE SHAFT AXIS. Every pad position is taken from the manufacturer's own recommended PCB layout on page 2 of the datasheet, not adapted from another part. https://www.bourns.com/docs/product-datasheets/pec11r.pdf (REV. D04/26)")
  (tags "rotary encoder threaded bushing panel mount M7x0.75 bourns pec11r switch vertical")
  (fp_text reference REF** (at 0 -9.9) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value RotaryEncoder_Bourns_PEC11R-4215F-S0024_Vertical_ThreadedM7Bushing (at 0 10.4) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text user %R (at 0 0) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )

  (fp_line (start -6.25 -6.7) (end 6.25 -6.7) (layer F.Fab) (width 0.12))
  (fp_line (start 6.25 -6.7) (end 6.25 6.7) (layer F.Fab) (width 0.12))
  (fp_line (start 6.25 6.7) (end -6.25 6.7) (layer F.Fab) (width 0.12))
  (fp_line (start -6.25 6.7) (end -6.25 -6.7) (layer F.Fab) (width 0.12))
  (fp_circle (center 0 0) (end 3.5 0) (layer F.Fab) (width 0.12))
  (fp_circle (center 0 0) (end 3 0) (layer F.Fab) (width 0.12))

  (fp_line (start -6.25 -6.7) (end -4.2 -6.7) (layer F.SilkS) (width 0.12))
