(module RotaryEncoder_Bourns_PEC12R-4017F-N0024_Vertical_17.5mmShaft (layer F.Cu) (tedit 68E9A000)
  (descr "Bourns PEC12R-4017F-N0024: 12 mm incremental encoder, insulated flatted shaft, NO push switch, NO detents, 24 pulses, NO bushing, 17.5 mm shaft (L = 17.5, flat F = 5.0), AXIAL PC pins so the shaft stands perpendicular to the board (ordering digit 4 = 'Horizontal Mount - Axial PC Pin/No Bushing'; NOT the 2xxx radial-pin family, whose shaft lies parallel to the board). AUTHORED 2026-10-16 from Bourns PEC12R datasheet rev 07/21 (references/components/encoders/bourns-pec12r-datasheet.pdf), PAGE 4, drawing 'PEC12R-4xxxF-Nxxxx (Horizontal Mount - Axial PC Pin/No Bushing, No Switch)' and its PCB layout; ordering code from page 1. ORIGIN is ON THE SHAFT AXIS. SOURCED from page 4: 3 pin holes drill 1.0 (+0.2/-0) at 5.0 mm A to B (pitch 2.5), pin order A C B left to right, on a row 7.5 mm from the shaft axis; 2 leg slots 2.0 x 2.1 (+0.2/-0) on the shaft-axis row, 13.2 apart outer edge to outer edge so centres at +/-5.6; body 12.4 wide x 13.4 deep; shaft o6.0 (+0/-0.1) with a 4.5 (+0/-0.1) across-flats flat. UNSOURCED (this author's choice or measurement): the collar diameter o7.0 (page 4 does not dimension it; 7.0 is the DIA callout on the page 2 radial-pin drawing of the same family, read as the collar), the body's split of the 13.4 about the axis (-6.2 / +7.2, measured off the page 4 front view at 300 dpi), annular pad 1.8 on the pins, 3.0 x 3.1 copper around each leg slot, courtyard, silk, leg pad name MP and plating (the layout gives hole sizes only), the 1.0 drill taken at the layout's nominal. Pin 1 does not exist on this part: pads are named A, C, B as on the drawing; A is the left pin seen from above with the pins toward +y (down). https://www.bourns.com/docs/product-datasheets/pec12r.pdf")
  (tags "rotary encoder bourns PEC12R PEC12R-4017F-N0024 vertical no switch no detents flatted")
  (fp_text reference REF** (at 0 -7.9) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value RotaryEncoder_Bourns_PEC12R-4017F-N0024_Vertical_17.5mmShaft (at 0 10.4) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text user %R (at 0 0) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )

  (fp_line (start -6.2 -6.2) (end 6.2 -6.2) (layer F.Fab) (width 0.12))
  (fp_line (start 6.2 -6.2) (end 6.2 7.2) (layer F.Fab) (width 0.12))
  (fp_line (start 6.2 7.2) (end -6.2 7.2) (layer F.Fab) (width 0.12))
  (fp_line (start -6.2 7.2) (end -6.2 -6.2) (layer F.Fab) (width 0.12))
  (fp_circle (center 0 0) (end 3.5 0) (layer F.Fab) (width 0.12))
  (fp_circle (center 0 0) (end 3 0) (layer F.Fab) (width 0.12))

  (fp_line (start -6.3 -6.3) (end -3.5 -6.3) (layer F.SilkS) (width 0.12))
  (fp_line (start 3.5 -6.3) (end 6.3 -6.3) (layer F.SilkS) (width 0.12))
  (fp_line (start -6.3 -6.3) (end -6.3 -2.4) (layer F.SilkS) (width 0.12))
  (fp_line (start 6.3 -6.3) (end 6.3 -2.4) (layer F.SilkS) (width 0.12))
  (fp_line (start -6.3 2.4) (end -6.3 7.3) (layer F.SilkS) (width 0.12))
  (fp_line (start 6.3 2.4) (end 6.3 7.3) (layer F.SilkS) (width 0.12))
  (fp_line (start -6.3 7.3) (end -4.0 7.3) (layer F.SilkS) (width 0.12))
  (fp_line (start 4.0 7.3) (end 6.3 7.3) (layer F.SilkS) (width 0.12))

  (fp_line (start -7.5 -7.1) (end 7.5 -7.1) (layer F.CrtYd) (width 0.05))
  (fp_line (start 7.5 -7.1) (end 7.5 8.6) (layer F.CrtYd) (width 0.05))
  (fp_line (start 7.5 8.6) (end -7.5 8.6) (layer F.CrtYd) (width 0.05))
  (fp_line (start -7.5 8.6) (end -7.5 -7.1) (layer F.CrtYd) (width 0.05))

  (pad A thru_hole rect (at -2.5 7.5) (size 1.8 1.8) (drill 1) (layers *.Cu *.Mask))
  (pad C thru_hole circle (at 0 7.5) (size 1.8 1.8) (drill 1) (layers *.Cu *.Mask))
  (pad B thru_hole circle (at 2.5 7.5) (size 1.8 1.8) (drill 1) (layers *.Cu *.Mask))
  (pad MP_1 thru_hole rect (at -5.6 0) (size 3 3.1) (drill oval 2 2.1) (layers *.Cu *.Mask))
  (pad MP_2 thru_hole rect (at 5.6 0) (size 3 3.1) (drill oval 2 2.1) (layers *.Cu *.Mask))
)
