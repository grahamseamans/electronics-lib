(module OLED_HS13L03W2C01_1.3in_MidBoard_Courtyard (layer F.Cu) (tedit 68EB0001)
  (descr "MIDDLE-board footprint of the HS (Shenzhen Hansheng) HS13L03W2C01 1.3in 128x64 I2C OLED module (LCSC C7465997) as press places it: NO PADS and NO SOCKET, only the courtyard of the module that hangs from the BACK of the front panel (OLED_HS13L03W2C01_1.3in_FrontPanel) over this board, so nothing else is placed under it. AUTHORED 2026-10-13 for studio/press. ORIGIN is the ACTIVE-AREA CENTRE, the same point OLED_HS13L03W2C01_1.3in_FrontPanel is datumed on, so one placement locates both. SOURCED: the module PCB outline 35.40 x 33.50 as (-17.7..17.7, -14.7..18.8) in this origin (HS13L03W2C01 datasheet section 1.4 mechanical drawing: holes 30.40 x 28.50 pitch, upper holes 2.50 from the top edge, active-area centre 14.70 from the top edge), the pin-header edge toward -y. The module's back is about 1.3 mm above this board with a 5.0 mm panel gap (datasheet side view 1.5 + 1.2 + 1.0 = 3.7 mm deep). UNSOURCED: the courtyard is the outline grown 0.30 mm per side (the same margin as the front-panel footprint). The JST socket the module's pigtail plugs into is NOT here: it is its own part (JST_SH_SM04B-SRSS-TB_1x04-1MP_P1.00mm_Horizontal_UniquePadNames), placed by the designer.")
  (tags "OLED HS13L03W2C01 SH1106 1.3in courtyard C7465997")
  (fp_text reference REF** (at 0 -16.5) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value OLED_HS13L03W2C01_1.3in_MidBoard_Courtyard (at 0 21) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text user %R (at 0 0) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_line (start -17.7 -14.7) (end 17.7 -14.7) (layer F.Fab) (width 0.1))
  (fp_line (start 17.7 -14.7) (end 17.7 18.8) (layer F.Fab) (width 0.1))
  (fp_line (start 17.7 18.8) (end -17.7 18.8) (layer F.Fab) (width 0.1))
  (fp_line (start -17.7 18.8) (end -17.7 -14.7) (layer F.Fab) (width 0.1))
  (fp_line (start -18 -15) (end 18 -15) (layer F.CrtYd) (width 0.05))
  (fp_line (start 18 -15) (end 18 19.1) (layer F.CrtYd) (width 0.05))
  (fp_line (start 18 19.1) (end -18 19.1) (layer F.CrtYd) (width 0.05))
  (fp_line (start -18 19.1) (end -18 -15) (layer F.CrtYd) (width 0.05))
)
