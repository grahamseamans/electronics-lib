(module OLED_HS13L03W2C01_MidBoard_JST_SH_SM04B-SRSS-TB_Socket (layer F.Cu) (tedit 68EB0000)
  (descr "MIDDLE-board footprint of the HS13L03W2C01 1.3in OLED screen (LCSC C7465997) as press places it: the screen module hangs from the BACK of the front panel (OLED_HS13L03W2C01_1.3in_FrontPanel) and a JST-SH pigtail soldered to its four pads plugs into a side-entry JST SM04B-SRSS-TB socket (LCSC C160404) here. AUTHORED 2026-10-12 for studio/press. ORIGIN is the screen's ACTIVE-AREA CENTRE, the same point the front-panel footprint is datumed on, so one placement locates both. SOURCED: the socket's pads, body and courtyard are upstream KiCad Connector_JST:JST_SH_SM04B-SRSS-TB_1x04-1MP_P1.00mm_Horizontal (kicad-footprints 7ebfa6b, from JST eSH.pdf), translated by (0, -23.0), with its two mounting pads renamed MP_1 / MP_2 because press refuses duplicate pad names; the plug enters from +y, opposite the signal pads (JST eSH catalogue side-entry drawing). Pin numbers are the STEMMA QT order (Adafruit 4440 rev B schematic, JST_SH4: 1 GND, 2 V+, 3 SDA, 4 SCL); the module's pads are GND VCC SCL SDA (HS13L03W2C01 datasheet section 1.5), so the pigtail crosses wires 3 and 4. The F.Fab module outline (-17.7..17.7, -14.7..18.8) is the module PCB from OLED_HS13L03W2C01_1.3in_FrontPanel; the courtyard covers it because the module's back is about 1.3 mm above this board with a 5.0 mm panel gap (datasheet side view 1.5 + 1.2 + 1.0 = 3.7 mm deep). CHOSEN, not sourced: the socket centre 23.0 mm from the active-area centre toward the module's pad edge (-y): 8.3 mm past the module edge (-14.7) so the plug clears the module, and well inside a 25 mm half of a 50 mm JST-SH cable.")
  (tags "OLED HS13L03W2C01 SH1106 JST SH SM04B-SRSS-TB C160404 C7465997 STEMMA QT")
  (attr smd)
  (fp_text reference REF** (at 0 -28.5) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value OLED_HS13L03W2C01_MidBoard_JST_SH_SM04B-SRSS-TB_Socket (at 0 20.5) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text user %R (at 0 0) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_line (start -17.7 -14.7) (end 17.7 -14.7) (layer F.Fab) (width 0.1))
  (fp_line (start 17.7 -14.7) (end 17.7 18.8) (layer F.Fab) (width 0.1))
  (fp_line (start 17.7 18.8) (end -17.7 18.8) (layer F.Fab) (width 0.1))
  (fp_line (start -17.7 18.8) (end -17.7 -14.7) (layer F.Fab) (width 0.1))
  (fp_line (start -3 -24.675) (end 3 -24.675) (layer F.Fab) (width 0.1))
  (fp_line (start 3 -24.675) (end 3 -20.425) (layer F.Fab) (width 0.1))
  (fp_line (start 3 -20.425) (end -3 -20.425) (layer F.Fab) (width 0.1))
  (fp_line (start -3 -20.425) (end -3 -24.675) (layer F.Fab) (width 0.1))
  (fp_line (start -2 -24.675) (end -1.5 -23.967893) (layer F.Fab) (width 0.1))
  (fp_line (start -1.5 -23.967893) (end -1 -24.675) (layer F.Fab) (width 0.1))
  (fp_line (start -3.9 -26.28) (end 3.9 -26.28) (layer F.CrtYd) (width 0.05))
  (fp_line (start 3.9 -26.28) (end 3.9 -15) (layer F.CrtYd) (width 0.05))
  (fp_line (start 3.9 -15) (end 18 -15) (layer F.CrtYd) (width 0.05))
  (fp_line (start 18 -15) (end 18 19.1) (layer F.CrtYd) (width 0.05))
  (fp_line (start 18 19.1) (end -18 19.1) (layer F.CrtYd) (width 0.05))
  (fp_line (start -18 19.1) (end -18 -15) (layer F.CrtYd) (width 0.05))
  (fp_line (start -18 -15) (end -3.9 -15) (layer F.CrtYd) (width 0.05))
  (fp_line (start -3.9 -15) (end -3.9 -26.28) (layer F.CrtYd) (width 0.05))
  (pad 1 smd roundrect (at -1.5 -25) (size 0.6 1.55) (layers F.Cu F.Mask F.Paste) (roundrect_rratio 0.25))
  (pad 2 smd roundrect (at -0.5 -25) (size 0.6 1.55) (layers F.Cu F.Mask F.Paste) (roundrect_rratio 0.25))
  (pad 3 smd roundrect (at 0.5 -25) (size 0.6 1.55) (layers F.Cu F.Mask F.Paste) (roundrect_rratio 0.25))
